{
  "name": "homepage",
  "private": true,
  "version": "0.0.0",
  "description": "A bilingual personal homepage and project showcase built with Vue 3, Vite, and TypeScript.",
  "license": "MIT",
  "author": "Cubevlmu",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubevlmu/HomePage.git"
  },
  "homepage": "https://github.com/cubevlmu/HomePage",
  "bugs": {
    "url": "https://github.com/cubevlmu/HomePage/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:homepage && npm run build:projects && node scripts/merge-project-sites.mjs",
    "preview": "vite preview",
    "build:homepage": "vue-tsc --noEmit && vite build",
    "build:projects": "npm run build --workspace @homepage/project-sites",
    "dev:projects": "npm run dev --workspace @homepage/project-sites"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@types/markdown-it": "^14.1.2",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.1.3",
    "@vitejs/plugin-vue": "^6.0.5",
    "markdown-it": "^14.1.1",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3",
    "vue-tsc": "^3.2.5"
  },
  "workspaces": [
    "project-sites"
  ]
}
