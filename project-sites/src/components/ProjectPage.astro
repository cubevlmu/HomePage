---
import ProjectLayout from '../layouts/ProjectLayout.astro'
import { pathFor, type Language, type Project, type Section } from '../lib/catalog'
import { manifestExample, commandExample, cmakeExample } from '../lib/snippets'

interface Props {
  project: Project
  language: Language
  section: Section
}

const { project, language, section } = Astro.props
const copy = project.copy[language]
const docsUrl = project.repository + '/blob/main/docs/INDEX.md'
---

<ProjectLayout project={project} language={language} section={section}>
  {section === 'home' && (
    <>
      <section class="hero">
        <div class="hero-copy">
          <div class="eyebrow"><span class="tiny-dot"></span>{copy.eyebrow}</div>
          <div class="state-label"><span class="pulse-dot"></span>{copy.status}<span class="state-separator"></span>{copy.openSource}</div>
          <h1>{copy.heroLead}<br /><em>{copy.heroAccent}</em></h1>
          <p class="hero-intro">{copy.summary}</p>
          <div class="cta-row">
            <a class="button button-primary" href={pathFor(project, language, 'guide')}>{copy.primary} <span aria-hidden="true">↗</span></a>
            <a class="button button-secondary" href={project.repository} target="_blank" rel="noopener noreferrer">{copy.github} <span aria-hidden="true">↗</span></a>
          </div>
          <div class="keyword-row" aria-label="Technologies">{copy.keywords.map((item) => <span>{item}</span>)}</div>
        </div>
        <div class="hero-console">
          <div class="terminal">
            <div class="terminal-bar"><span class="traffic"><i></i><i></i><i></i></span><span>rhodium / workflow</span><span class="terminal-flag">CLI</span></div>
            <div class="terminal-body">
              <div class="terminal-label">01 · MANIFEST</div>
              <p><span class="console-key">require</span><span class="console-muted">(</span><span class="console-string">"fmt"</span><span class="console-muted">, {'{ ... }'}</span><span class="console-muted">)</span></p>
              <div class="terminal-label">02 · RESTORE</div>
              <p><span class="console-prompt">$</span> rhodium restore <span class="console-muted">--config debug</span></p>
              <p class="console-success">✓ dependencies ready</p>
              <div class="terminal-label">03 · GENERATE</div>
              <p><span class="console-prompt">$</span> rhodium generate</p>
              <p class="console-success">✓ CMake integration generated</p>
            </div>
            <div class="terminal-bottom"><span>rhodium.lua</span><span>→</span><span>artifacts</span><span>→</span><span>CMake</span></div>
          </div>
          <div class="float-label" aria-hidden="true">RH / 45 <span>DEPENDENCIES IN ORDER</span></div>
        </div>
      </section>
      <section class="section-block home-features">
        <div class="section-heading"><div><p class="section-kicker">/ WHY RHODIUM</p><h2>{copy.featureTitle}</h2><p>{copy.featureLead}</p></div><a class="text-link" href={pathFor(project, language, 'features')}>{copy.featureLink} <span aria-hidden="true">↗</span></a></div>
        <div class="feature-grid">
          {copy.features.slice(0, 3).map(([title, detail], index) => (
            <article class="feature-card"><span class="feature-index">0{index + 1} / FEATURE</span><h3>{title}</h3><p>{detail}</p><span class="feature-arrow" aria-hidden="true">↗</span></article>
          ))}
        </div>
      </section>
      <section class="section-block workflow-block">
        <div class="section-heading"><div><p class="section-kicker">/ THE WORKFLOW</p><h2>{copy.flowTitle}</h2><p>{copy.flowLead}</p></div></div>
        <ol class="flow-grid">{copy.steps.map(([title, detail]) => <li><strong>{title}</strong><p>{detail}</p></li>)}</ol>
      </section>
    </>
  )}

  {section === 'features' && (
    <>
      <header class="inner-hero"><p class="section-kicker">/ CAPABILITIES</p><h1>{copy.featureTitle}</h1><p>{copy.featureLead}</p></header>
      <div class="feature-grid expanded">
        {copy.features.map(([title, detail], index) => (
          <article class="feature-card"><span class="feature-index">0{index + 1} / FEATURE</span><h2>{title}</h2><p>{detail}</p><span class="feature-arrow" aria-hidden="true">↗</span></article>
        ))}
      </div>
      <section class="section-block">
        <div class="section-heading"><div><p class="section-kicker">/ SUPPORT MATRIX</p><h2>{copy.platformTitle}</h2><p>{copy.platformLead}</p></div></div>
        <div class="platform-list">{copy.platforms.map(([name, support]) => <div class="platform-row"><strong>{name}</strong><span>{support}</span></div>)}</div>
      </section>
      <section class="boundary"><span class="section-kicker">/ SCOPE</span><h2>{copy.boundaryTitle}</h2><p>{copy.boundaryText}</p></section>
    </>
  )}

  {section === 'guide' && (
    <>
      <header class="inner-hero"><p class="section-kicker">/ GET STARTED</p><h1>{copy.guideTitle}</h1><p>{copy.guideLead}</p></header>
      <div class="guide-list">
        {copy.guideHeadings.map((title, index) => (
          <section class="guide-step">
            <div class="guide-number">0{index + 1}</div>
            <div class="guide-content">
              <h2>{title}</h2><p>{copy.guideDescriptions[index]}</p>
              {index === 0 && <div class="inline-tags"><span>Git</span><span>CMake 3.25+</span><span>C++20</span><span>vcpkg</span><span>Ninja (recommended)</span></div>}
              {index === 1 && <div class="code-window"><div class="code-caption"><span>rhodium.lua</span><span>LUA</span></div><pre><code>{manifestExample}</code></pre></div>}
              {index === 2 && <div class="code-window"><div class="code-caption"><span>terminal</span><span>CLI</span></div><pre><code>{commandExample}</code></pre></div>}
              {index === 3 && <div class="code-window"><div class="code-caption"><span>CMakeLists.txt</span><span>CMAKE</span></div><pre><code>{cmakeExample}</code></pre></div>}
            </div>
          </section>
        ))}
      </div>
      <section class="boundary"><span class="section-kicker">/ NOTES</span><ul>{copy.guideNotes.map((note) => <li>{note}</li>)}</ul><a class="text-link" href={project.repository + '/blob/main/docs/getting-started.md'} target="_blank" rel="noopener noreferrer">{copy.docs} ↗</a></section>
    </>
  )}

  {section === 'reference' && (
    <>
      <header class="inner-hero"><p class="section-kicker">/ REFERENCE</p><h1>{copy.referenceTitle}</h1><p>{copy.referenceLead}</p></header>
      <div class="reference-table" role="region" aria-label="Rhodium commands" tabindex="0">
        <table><thead><tr><th scope="col">COMMAND</th><th scope="col">{language === 'zh' ? '用途' : 'Purpose'}</th></tr></thead>
          <tbody>{copy.commands.map(([command, detail]) => <tr><th scope="row"><code>{command}</code></th><td>{detail}</td></tr>)}</tbody></table>
      </div>
      <section class="boundary"><span class="section-kicker">/ COMPATIBILITY</span><p>{copy.referenceNote}</p><a class="text-link" href={project.repository + '/blob/main/docs/reference/command-reference.md'} target="_blank" rel="noopener noreferrer">{copy.docs} ↗</a></section>
    </>
  )}
  <section class="bottom-cta"><div><p class="section-kicker">/ OPEN SOURCE</p><h2>{project.name} <span>on GitHub</span></h2></div><a class="button button-secondary" href={project.repository} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></section>
</ProjectLayout>
